.venv/
__pycache__/
*.pyc
.env
.vscode/
data/user_state.json
# 状态备份（reset.py 生成，测试用）
data/backups/
# 测试临时目录
tests/.tmp/
# RAG 产物：语料 / 切块 / Qdrant 库 / embedding 模型（大，且可由脚本重建）
data/rag/
# 评测 run 结果（可重新生成；评测集本身 evals/dataset/ 需提交）
evals/results/
# 评测集可读总览（由 run_eval.py --export-md 生成的派生物）
evals/*_overview.md
# 指标事件（本机运行产物，可由 app 运行时重新采集）
data/metrics/
# 测试审计的结构化派生物（由 tests/audit.py --json 生成，可重生成；报告 .md 需提交）
docs/test-audit.json